+void STM32I2C::ClearPendingOperation(bool in_isr)
+{
+  if (in_isr)
+  {
+    const UBaseType_t interrupt_mask = taskENTER_CRITICAL_FROM_ISR();
+    read_op_ = ReadOperation();
+    write_op_ = WriteOperation();
+    read_buff_ = RawData();
+    taskEXIT_CRITICAL_FROM_ISR(interrupt_mask);
+    return;
+  }
+
+  taskENTER_CRITICAL();
+  read_op_ = ReadOperation();
+  write_op_ = WriteOperation();
+  read_buff_ = RawData();
+  taskEXIT_CRITICAL();
+}
+
+void STM32I2C::AbortTransfer(uint16_t slave_addr)
+{
+  if (i2c_handle_ == nullptr)
+  {
+    return;
+  }
+
+  if (i2c_handle_->State != HAL_I2C_STATE_READY)
+  {
+    (void)HAL_I2C_Master_Abort_IT(i2c_handle_, slave_addr);
+  }
+}
+
+ErrorCode STM32I2C::WaitBlockingDma(WriteOperation &op, uint16_t slave_addr)
+{
+  const ErrorCode wait_ec = op.data.sem_info.sem->Wait(op.data.sem_info.timeout);
+  if (wait_ec != ErrorCode::OK)
+  {
+    ClearPendingOperation();
+    AbortTransfer(slave_addr);
+    return wait_ec;
+  }
+
+  return ErrorCode::OK;
+}
