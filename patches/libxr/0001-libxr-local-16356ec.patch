+ErrorCode STM32I2C::RecoverBus()
+{
+  if (i2c_handle_ == nullptr)
+  {
+    return ErrorCode::PTR_NULL;
+  }
+
+  if (id_ != stm32_i2c_id_t::STM32_I2C1)
+  {
+    return ErrorCode::NOT_SUPPORT;
+  }
+
+  (void)HAL_I2C_DeInit(i2c_handle_);
+
+  ConfigureRecoveryPinsForI2C1();
+  DelayForRecovery();
+
+  if (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_7) == GPIO_PIN_RESET)
+  {
+    for (uint32_t i = 0; i < kRecoveryPulseCount; ++i)
+    {
+      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_6, GPIO_PIN_RESET);
+      DelayForRecovery();
+      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_6, GPIO_PIN_SET);
+      DelayForRecovery();
+
+      if (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_7) == GPIO_PIN_SET)
+      {
+        break;
+      }
+    }
+  }
+
+  GenerateStopForI2C1();
+  MX_I2C1_Init();
+
+  return (i2c_handle_->State == HAL_I2C_STATE_READY) ? ErrorCode::OK
+                                                     : ErrorCode::FAILED;
+}
