+static inline void STM32_UART_RX_Push(STM32UART *uart, uint8_t *data, size_t len)
+{
+  if (len == 0)
+  {
+    return;
+  }
+
+  uart->diag_stats_.rx_received_bytes += len;
+  auto ans = uart->read_port_->queue_data_->PushBatch(data, len);
+  if (ans == ErrorCode::OK)
+  {
+    uart->diag_stats_.rx_queued_bytes += len;
+  }
+  else
+  {
+    ++uart->diag_stats_.rx_queue_full_count;
+    uart->diag_stats_.rx_dropped_bytes += len;
+  }
+}
+
+static inline HAL_StatusTypeDef STM32_UART_Restart_RX_DMA(STM32UART *uart)
+{
+  if (uart == nullptr || uart->uart_handle_ == nullptr ||
+      uart->dma_buff_rx_.addr_ == nullptr || uart->dma_buff_rx_.size_ == 0)
+  {
+    return HAL_ERROR;
+  }
+
+  auto huart = uart->uart_handle_;
+
+  ATOMIC_CLEAR_BIT(huart->Instance->CR1,
+                   USART_CR1_IDLEIE | USART_CR1_RXNEIE | USART_CR1_PEIE);
+  ATOMIC_CLEAR_BIT(huart->Instance->CR3, USART_CR3_EIE | USART_CR3_DMAR);
+
+  __HAL_UART_CLEAR_PEFLAG(huart);
+  __HAL_UART_CLEAR_IDLEFLAG(huart);
+
+  huart->RxXferCount = 0;
+  huart->RxState = HAL_UART_STATE_READY;
+  huart->ReceptionType = HAL_UART_RECEPTION_STANDARD;
+  huart->ErrorCode = HAL_UART_ERROR_NONE;
+  uart->last_rx_pos_ = 0;
+
+  ++uart->diag_stats_.rx_restart_count;
+  auto ans = HAL_UARTEx_ReceiveToIdle_DMA(
+      huart, reinterpret_cast<uint8_t *>(uart->dma_buff_rx_.addr_),
+      uart->dma_buff_rx_.size_);
+  if (ans != HAL_OK)
+  {
+    ++uart->diag_stats_.rx_restart_fail_count;
+  }
+  return ans;
+}
